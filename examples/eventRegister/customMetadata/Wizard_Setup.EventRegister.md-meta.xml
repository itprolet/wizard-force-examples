<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Event Register Wizard</label>
    <protected>false</protected>
    <values>
        <field>Title__c</field>
        <value xsi:type="xsd:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">Event Register</value>
    </values>
    <values>
        <field>Plan__c</field>
        <value xsi:type="xsd:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">{
            "Attendee": "EventRegisterAttendee",
            "if (EventRegisterAttendee.type='speaker')": {
                "Talk": "EventRegisterEventTalk"
            },
            "Preferences": "EventRegisterPreferences",
            "Summary": "EventRegisterSummary"
        }</value>
    </values>
    <values>
        <field>Rules__c</field>
        <value xsi:type="xsd:string" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">{
            "EventRegisterAttendee": {
                "required": ["firstName", "lastName", "email", "type"],
                "validators": { "email": ["ValidateEmail"] }
            },
            "EventRegisterEventTalk": {
                "required": ["talkTitle", "talkLength"]
            },
            "EventRegisterPreferences": {
                "required": ["tshirtSize", "dietary"],
                "if (dietary='other')": { "required": ["dietaryDetails"] },
                "if (bringGuest)": { "required": ["guestName"] }
            }
        }</value>
    </values>
</CustomMetadata>