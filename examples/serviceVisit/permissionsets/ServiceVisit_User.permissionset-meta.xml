<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Service Visit User</label>
    <description>Access to the serviceVisit wizard: its objects, fields, Apex controllers, tabs and apps. Assign together with prolet__Wizard_Framework_User.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- WIZARD-MAKER: generated by "npm run make permset" from the files in the serviceVisit folder.
         Running it again regenerates this file and replaces changes made by hand. -->

    <!-- Apex classes the wizard pages call -->
    <classAccesses>
        <apexClass>ServiceVisitController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Service_Visit__c: fields -->
    <fieldPermissions>
        <field>Service_Visit__c.Account__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Contact_Email__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Contact__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Devices_Note__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Devices__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Problem__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Serial_Code__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Under_Warranty__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Urgent_Reason__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Urgent__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Visit_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Visit_Type__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Visit__c.Wizard__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <!-- Service_Visit__c: records -->
    <objectPermissions>
        <object>Service_Visit__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <!-- WIZARD-MAKER optional: see and change the records of ALL users (admins / managers only) -->
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Tabs -->
    <tabSettings>
        <tab>Service_Visit__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
