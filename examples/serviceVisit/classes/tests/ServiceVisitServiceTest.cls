/**
 * Tests of ServiceVisitService and ServiceVisitController.
 * WIZARD-MAKER: generated by "npm run make submit". Add a test for every rule you write in the service.
 */
@isTest
private class ServiceVisitServiceTest {

    /** The type of the wizard, and its steps to the summary (the steps of the plan that are always shown). */
    private static final String WIZARD_TYPE = 'ServiceVisit';
    private static final List<prolet.WizardPageData> PATH = new List<prolet.WizardPageData>{
        new prolet.WizardPageData('Customer', 'ServiceVisitCustomer'),
        new prolet.WizardPageData('Visit', 'ServiceVisitVisit'),
        new prolet.WizardPageData('Summary', 'ServiceVisitSummary')
    };

    /**
     * A finished wizard, as WizardApi.assertCompleted accepts it: its path reached the summary, and
     * every field of those pages has an answer (a mapped one fits its field of Service_Visit__c).
     */
    private static prolet__Wizard__c createWizard() {
        Map<String, Object> model = new Map<String, Object>{
            'ServiceVisitCustomer' => new Map<String, Object>{
                'account' => lookupRecord('Account'),
                'contact' => lookupRecord('Contact'),
                'contactEmail' => 'test@example.com'
            },
            'ServiceVisitVisit' => new Map<String, Object>{
                'visitType' => 'repair',
                'visitDate' => '2026-01-15',
                'devices' => '1',
                'devicesNote' => 'Test',
                'urgent' => true,
                'urgentReason' => 'Test'
            },
            'ServiceVisitRepairDetails' => new Map<String, Object>{
                'problem' => 'Test',
                'underWarranty' => true,
                'serialCode' => 'Test'
            }
        };
        return insertWizard(JSON.serialize(model), PATH);
    }

    /**
     * The path as the framework stores it, written from maps: Apex outside the framework's package
     * cannot serialize the package's classes (WizardPageData), so JSON.serialize(path) fails there.
     */
    private static String pathJson(List<prolet.WizardPageData> path) {
        List<Map<String, Object>> pages = new List<Map<String, Object>>();
        for (prolet.WizardPageData page : path) {
            pages.add(new Map<String, Object>{ 'title' => page.title, 'page' => page.page, 'initParams' => page.initParams });
        }
        return JSON.serialize(pages);
    }

    /** A wizard of this type with these answers, on this path */
    private static prolet__Wizard__c insertWizard(String modelJson, List<prolet.WizardPageData> path) {
        // ACTIVE written, not left to the picklist default: a wizard without a state is locked
        prolet__Wizard__c wizard = new prolet__Wizard__c(
            prolet__Wizard_Type__c = WIZARD_TYPE,
            prolet__State__c = prolet.WizardStates.ACTIVE,
            prolet__Model__c = modelJson,
            prolet__Path__c = pathJson(path)
        );
        insert wizard;
        return wizard;
    }

    /** One record per object for the lookups of the wizard: the fields a new record needs get a test value. */
    private static Map<String, Id> lookupRecords = new Map<String, Id>();

    private static Id lookupRecord(String objectName) {
        if (!lookupRecords.containsKey(objectName)) {
            SObject record = Schema.getGlobalDescribe().get(objectName).newSObject();
            for (Schema.SObjectField field : record.getSObjectType().getDescribe().fields.getMap().values()) {
                Schema.DescribeFieldResult describe = field.getDescribe();
                if (describe.isCreateable() && !describe.isNillable() && !describe.isDefaultedOnCreate()) {
                    record.put(field, testValue(describe));
                }
            }
            insert record;
            lookupRecords.put(objectName, record.Id);
        }
        return lookupRecords.get(objectName);
    }

    private static Object testValue(Schema.DescribeFieldResult describe) {
        switch on describe.getType() {
            when DOUBLE, CURRENCY, PERCENT, INTEGER, LONG {
                return 1;
            }
            when DATE {
                return Date.today();
            }
            when DATETIME {
                return Datetime.now();
            }
            when EMAIL {
                return 'test@example.com';
            }
            when PICKLIST {
                return describe.getPicklistValues()[0].getValue();
            }
            when else {
                return 'Test';
            }
        }
    }

    @isTest
    static void submitCreatesTheRecord() {
        prolet__Wizard__c wizard = createWizard();

        Test.startTest();
        Id recordId = ServiceVisitController.submit(wizard.Id, true);
        Test.stopTest();

        Service_Visit__c record = [
            SELECT Id, Wizard__c
            FROM Service_Visit__c
            WHERE Id = :recordId
        ];
        Assert.areEqual(wizard.Id, record.Wizard__c, 'The record is linked to its wizard');
    }

    @isTest
    static void aSecondSubmitIsRefused() {
        prolet__Wizard__c wizard = createWizard();
        ServiceVisitController.submit(wizard.Id, true);
        Assert.areEqual('LOCKED', [SELECT prolet__State__c FROM prolet__Wizard__c WHERE Id = :wizard.Id].prolet__State__c,
                'The wizard can only be looked at');
        try {
            ServiceVisitController.submit(wizard.Id, true);
            Assert.fail('A second submit should fail');
        } catch (AuraHandledException e) {
            Assert.areEqual('This wizard was submitted already.', e.getMessage());
            Assert.areEqual(1, [SELECT COUNT() FROM Service_Visit__c], 'Nothing more was created');
        }
    }

    @isTest
    static void submitNeedsTheConfirmation() {
        prolet__Wizard__c wizard = createWizard();
        try {
            ServiceVisitController.submit(wizard.Id, false);
            Assert.fail('The submit should fail without the confirmation');
        } catch (AuraHandledException e) {
            // the service's own message, as it is (the controller's first catch)
            Assert.isFalse(e.getMessage().startsWith('Could not submit: '), e.getMessage());
            Assert.areEqual(0, [SELECT COUNT() FROM Service_Visit__c], 'Nothing was created');
        }
    }

    @isTest
    static void aWizardThatDidNotReachTheSummaryIsRefused() {
        prolet__Wizard__c wizard = insertWizard(JSON.serialize(new Map<String, Object>()), new List<prolet.WizardPageData>{ PATH[0] });
        try {
            ServiceVisitController.submit(wizard.Id, true);
            Assert.fail('The submit should fail before the last page');
        } catch (AuraHandledException e) {
            // the wizard's own message, as it is (the controller's catch of WizardException)
            Assert.isTrue(e.getMessage().startsWith(System.Label.get('prolet', 'Wizard_err_not_completed')), e.getMessage());
            Assert.areEqual(0, [SELECT COUNT() FROM Service_Visit__c], 'Nothing was created');
        }
    }

    @isTest
    static void anUnexpectedProblemReachesTheUserAsAMessage() {
        // data that cannot be read: not one of the service's own messages, so the controller's
        // last catch turns it into a message for the user (and this test covers that catch)
        prolet__Wizard__c wizard = insertWizard('not JSON', PATH);
        try {
            ServiceVisitController.submit(wizard.Id, true);
            Assert.fail('The submit should fail when the data cannot be read');
        } catch (AuraHandledException e) {
            // only the controller's last catch says this: if the service turns bad data into a
            // message of its own, this test fails instead of leaving that catch uncovered
            Assert.isTrue(e.getMessage().startsWith('Could not submit: '), e.getMessage());
            Assert.areEqual(0, [SELECT COUNT() FROM Service_Visit__c], 'Nothing was created');
        }
    }

    @isTest
    static void submitFailsWithoutData() {
        // on the summary, but without answers: no page has any to check, the service finds none
        prolet__Wizard__c wizard = insertWizard(null, PATH);
        try {
            ServiceVisitService.submit(wizard.Id, true);
            Assert.fail('The submit should fail when the wizard has no data');
        } catch (ServiceVisitException e) {
            Assert.areEqual('The wizard has no data.', e.getMessage(), 'The user sees why');
        }
    }
}
