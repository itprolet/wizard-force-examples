/**
 * Creates Membership_Application__c records from the clubMembership wizard.
 *
 * Wizard model (Wizard__c.Model__c) used here:
 *   ClubMembershipApplicant  → fullName, email, phone, website, birthDate, personalId, portalPin, address
 *   ClubMembershipMembership → plan, startDate, familyMembers, familyNames, premiumWishes, hasCompany
 *   ClubMembershipPayment    → method, iban, acceptRules
 *   ClubMembershipCompany    → company, contactPerson, partnerClub, bigClient, referredBy, vatNumber
 *
 * WIZARD-MAKER: generated by "npm run make submit" from the mappings of Membership_Application__c.
 * Running it again (e.g. after "make object" added a field) regenerates this file and
 * replaces changes made by hand in it, after asking first.
 */
public with sharing class ClubMembershipService {

    /**   Constants for page names   */
    public static final String PAGE_APPLICANT = 'ClubMembershipApplicant';
    public static final String PAGE_MEMBERSHIP = 'ClubMembershipMembership';
    public static final String PAGE_PAYMENT = 'ClubMembershipPayment';
    public static final String PAGE_COMPANY = 'ClubMembershipCompany';

    /**   Boiler methods for wizard connection   */

    /**
     * Loads the wizard record by its Id, locked until the end of the transaction: a second submit
     * (a double click, another tab) waits here and then finds the wizard locked by the first one.
     */
    private static prolet__Wizard__c loadWizard(Id wizardId) {
        List<prolet__Wizard__c> wizards = [
            SELECT Id, prolet__Model__c, prolet__State__c
            FROM prolet__Wizard__c
            WHERE Id = :wizardId
            LIMIT 1
            FOR UPDATE
        ];
        if (wizards.isEmpty()) {
            throw new ClubMembershipException('Wizard not found: ' + wizardId);
        }
        return wizards[0];
    }

    /** Turns the Model__c JSON text into a Map. */
    private static Map<String, Object> parseModel(String modelJson) {
        if (String.isBlank(modelJson)) {
            throw new ClubMembershipException('The wizard has no data.');
        }
        return (Map<String, Object>) JSON.deserializeUntyped(modelJson);
    }

    /** Returns one page's answers, or an empty Map if the page has no data. */
    private static Map<String, Object> getPage(Map<String, Object> model, String pageName) {
        Object page = model.get(pageName);
        if (page instanceof Map<String, Object>) {
            return (Map<String, Object>) page;
        }
        return new Map<String, Object>();
    }

    /**   Helper methods for converting   */

    /** Reads a text value, or null. */
    private static String getString(Map<String, Object> page, String field) {
        Object value = page.get(field);
        return value == null ? null : String.valueOf(value);
    }

    /** Reads a number value, or null. */
    private static Decimal getDecimal(Map<String, Object> page, String field) {
        String value = getString(page, field);
        return String.isBlank(value) ? null : Decimal.valueOf(value);
    }

    /** Reads a date saved as "YYYY-MM-DD", or null. */
    private static Date getDate(Map<String, Object> page, String field) {
        String value = getString(page, field);
        return String.isBlank(value) ? null : Date.valueOf(value);
    }

    /** Reads a checkbox value; anything that is not true counts as false. */
    private static Boolean getBoolean(Map<String, Object> page, String field) {
        Object value = page.get(field);
        return value instanceof Boolean && (Boolean) value;
    }

    /** Reads a record Id (from a lookup), or null. */
    private static Id getId(Map<String, Object> page, String field) {
        String value = getString(page, field);
        return String.isBlank(value) ? null : Id.valueOf(value);
    }

    /**   Main methods: the mapping, and the place for your own rules   */

    /** Copies the wizard answers into a new Membership_Application__c (not inserted yet). */
    private static Membership_Application__c buildMembershipApplication(Id wizardId, Map<String, Object> model) {
        Map<String, Object> applicant = getPage(model, PAGE_APPLICANT);
        Map<String, Object> membership = getPage(model, PAGE_MEMBERSHIP);
        Map<String, Object> payment = getPage(model, PAGE_PAYMENT);
        Map<String, Object> company = getPage(model, PAGE_COMPANY);

        Membership_Application__c record = new Membership_Application__c();
        record.Wizard__c = wizardId;

        // Applicant
        record.Full_Name__c = getString(applicant, 'fullName');
        record.Email__c = getString(applicant, 'email');
        record.Mobile_Phone__c = getString(applicant, 'phone');
        record.Website__c = getString(applicant, 'website');
        record.Birth_Date__c = getDate(applicant, 'birthDate');
        record.Personal_Id__c = getString(applicant, 'personalId');
        record.Portal_Pin__c = getString(applicant, 'portalPin');
        record.Address__c = getString(applicant, 'address');

        // Membership
        record.Plan__c = getString(membership, 'plan');
        record.Start_Date__c = getDate(membership, 'startDate');
        record.Family_Members__c = getDecimal(membership, 'familyMembers');
        // Shown only if (familyMembers > 0): an answer of a hidden field is not saved.
        if (getDecimal(membership, 'familyMembers') > 0) {
            record.Family_Names__c = getString(membership, 'familyNames');
        }
        // Shown only if (plan='premium'): an answer of a hidden field is not saved.
        if (getString(membership, 'plan') == 'premium') {
            record.Premium_Wishes__c = getString(membership, 'premiumWishes');
        }
        record.I_Apply_For_A_Company__c = getBoolean(membership, 'hasCompany');

        // Payment and Rules
        record.Payment_Method__c = getString(payment, 'method');
        // Shown only if (method='bank'): an answer of a hidden field is not saved.
        if (getString(payment, 'method') == 'bank') {
            record.Iban__c = getString(payment, 'iban');
        }
        record.I_Accept_The_Club_Rules__c = getBoolean(payment, 'acceptRules');

        // Company
        record.Company__c = getId(company, 'company');
        record.Contact_Person__c = getId(company, 'contactPerson');
        record.Partner_Club__c = getId(company, 'partnerClub');
        record.Big_Client__c = getId(company, 'bigClient');
        record.Referred_By__c = getId(company, 'referredBy');
        record.Vat_Number__c = getString(company, 'vatNumber');

        // WIZARD-MAKER: your own rules go here. Examples:
        //
        // Stop the submit with a message for the user:
        // if (record.Amount__c == null || record.Amount__c <= 0) {
        //     throw new ClubMembershipException('The amount must be a positive number.');
        // }
        //
        // A value that is not asked in the wizard:
        // record.Status__c = 'pending';
        //
        // Save an answer only in some cases:
        // if (record.Quantity__c > 1) {
        //     record.Justification__c = getString(somePage, 'justification');
        // }
        return record;
    }

    /**
     * Creates the Membership_Application__c for a finished wizard, and locks the wizard: from then on
     * it can only be looked at, and a second click on Submit creates nothing. A wizard that did
     * not go through every page (or whose answers do not pass the rules of a page) is refused.
     * @return the Id of the new record
     */
    public static Id submit(Id wizardId, Boolean confirmed) {
        if (confirmed != true) {
            throw new ClubMembershipException('Please confirm before submitting.');
        }
        prolet__Wizard__c wizard = loadWizard(wizardId);
        if (prolet.WizardStates.isLocked(wizard.prolet__State__c)) {
            throw new ClubMembershipException('This wizard was submitted already.');
        }
        // the path reached the summary, and every page before it passes its rules
        prolet.WizardApi.assertCompleted(wizardId);
        Map<String, Object> model = parseModel(wizard.prolet__Model__c);
        Membership_Application__c record = buildMembershipApplication(wizard.Id, model);

        insert record;
        // the wizard framework: from now on the wizard can only be looked at
        prolet.WizardApi.lock(wizardId);
        return record.Id;
    }
}
