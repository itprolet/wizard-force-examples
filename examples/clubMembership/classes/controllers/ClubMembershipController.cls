/**
 * Entry point for the clubMembership wizard LWC (clubMembershipSummary).
 * WIZARD-MAKER: generated by "npm run make submit".
 */
public with sharing class ClubMembershipController {

    @AuraEnabled
    public static Id submit(Id wizardId, Boolean confirmed) {
        try {
            return ClubMembershipService.submit(wizardId, confirmed);
        } catch (ClubMembershipException e) {
            // our own messages (e.g. "Please confirm…") are shown to the user as they are
            throw forTheUser(e.getMessage());
        } catch (prolet.WizardException e) {
            // the wizard's (e.g. locked by another tab): shown as they are too
            throw forTheUser(e.getMessage());
        } catch (Exception e) {
            throw forTheUser('Could not submit: ' + e.getMessage());
        }
    }

    /**
     * The error the user sees. setMessage too: without it getMessage() says only
     * "Script-thrown exception", and a test could not tell which catch was used.
     */
    private static AuraHandledException forTheUser(String message) {
        AuraHandledException e = new AuraHandledException(message);
        e.setMessage(message);
        return e;
    }
}
