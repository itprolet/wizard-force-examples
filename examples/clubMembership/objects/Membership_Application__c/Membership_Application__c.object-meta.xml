<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Membership Application</label>
    <pluralLabel>Membership Applications</pluralLabel>
    <description>Membership Applications created by the clubMembership wizard</description>
    <nameField>
        <label>Membership Application Number</label>
        <type>AutoNumber</type>
        <displayFormat>MA-{00000}</displayFormat>
        <trackHistory>false</trackHistory>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>

    <!-- WIZARD-MAKER: who sees whose records.
         sharingModel:         ReadWrite = everyone sees and edits all · Read = everyone sees, only the owner edits · Private = only the owner
         externalSharingModel: the same, for Experience Cloud users (must not be more open than sharingModel) -->
    <sharingModel>Private</sharingModel>
    <externalSharingModel>Private</externalSharingModel>
    <visibility>Public</visibility>

    <!-- WIZARD-MAKER: features. Change false → true to switch one on. -->
    <enableReports>true</enableReports>             <!-- reports on these records -->
    <enableSearch>true</enableSearch>               <!-- found by the global search -->
    <enableActivities>false</enableActivities>      <!-- tasks and events -->
    <enableHistory>false</enableHistory>            <!-- field history (also set trackHistory on the fields) -->
    <enableFeeds>false</enableFeeds>                <!-- Chatter feed -->
    <allowInChatterGroups>false</allowInChatterGroups>
    <enableLicensing>false</enableLicensing>
    <!-- enableBulkApi, enableSharing and enableStreamingApi must all be true or all be false -->
    <enableBulkApi>true</enableBulkApi>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
</CustomObject>
