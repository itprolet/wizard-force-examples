/**
 * Creates Car_Booking__c records from the carRental wizard.
 *
 * Wizard model (Wizard__c.Model__c) used here:
 *   CarRentalDriver  → fullName, email, licenceNumber, licenceDate, age, experienced
 *   CarRentalCar     → pickupCity, carClass, pickupDate, days, fullInsurance, luxuryNotes, bookedThrough, carModel
 *   CarRentalExtras  → gps, childSeats, notes   if (CarRentalCar.days > 7)
 *   CarRentalInvoice → vatNumber, billingContact, bigCompany, openDeal   if (CarRentalCar.carClass='luxury')
 *
 * WIZARD-MAKER: generated by "npm run make submit" from the mappings of Car_Booking__c.
 * Running it again (e.g. after "make object" added a field) regenerates this file and
 * replaces changes made by hand in it, after asking first.
 */
public with sharing class CarRentalService {

    /**   Constants for page names   */
    public static final String PAGE_DRIVER = 'CarRentalDriver';
    public static final String PAGE_CAR = 'CarRentalCar';
    public static final String PAGE_EXTRAS = 'CarRentalExtras';
    public static final String PAGE_INVOICE = 'CarRentalInvoice';

    /**   Boiler methods for wizard connection   */

    /**
     * Loads the wizard record by its Id, locked until the end of the transaction: a second submit
     * (a double click, another tab) waits here and then finds the wizard locked by the first one.
     */
    private static prolet__Wizard__c loadWizard(Id wizardId) {
        List<prolet__Wizard__c> wizards = [
            SELECT Id, prolet__Model__c, prolet__State__c
            FROM prolet__Wizard__c
            WHERE Id = :wizardId
            LIMIT 1
            FOR UPDATE
        ];
        if (wizards.isEmpty()) {
            throw new CarRentalException('Wizard not found: ' + wizardId);
        }
        return wizards[0];
    }

    /** Turns the Model__c JSON text into a Map. */
    private static Map<String, Object> parseModel(String modelJson) {
        if (String.isBlank(modelJson)) {
            throw new CarRentalException('The wizard has no data.');
        }
        return (Map<String, Object>) JSON.deserializeUntyped(modelJson);
    }

    /** Returns one page's answers, or an empty Map if the page has no data. */
    private static Map<String, Object> getPage(Map<String, Object> model, String pageName) {
        Object page = model.get(pageName);
        if (page instanceof Map<String, Object>) {
            return (Map<String, Object>) page;
        }
        return new Map<String, Object>();
    }

    /**   Helper methods for converting   */

    /** Reads a text value, or null. */
    private static String getString(Map<String, Object> page, String field) {
        Object value = page.get(field);
        return value == null ? null : String.valueOf(value);
    }

    /** Reads a number value, or null. */
    private static Decimal getDecimal(Map<String, Object> page, String field) {
        String value = getString(page, field);
        return String.isBlank(value) ? null : Decimal.valueOf(value);
    }

    /** Reads a date saved as "YYYY-MM-DD", or null. */
    private static Date getDate(Map<String, Object> page, String field) {
        String value = getString(page, field);
        return String.isBlank(value) ? null : Date.valueOf(value);
    }

    /** Reads a checkbox value; anything that is not true counts as false. */
    private static Boolean getBoolean(Map<String, Object> page, String field) {
        Object value = page.get(field);
        return value instanceof Boolean && (Boolean) value;
    }

    /** Reads a record Id (from a lookup), or null. */
    private static Id getId(Map<String, Object> page, String field) {
        String value = getString(page, field);
        return String.isBlank(value) ? null : Id.valueOf(value);
    }

    /**   Main methods: the mapping, and the place for your own rules   */

    /** Copies the wizard answers into a new Car_Booking__c (not inserted yet). */
    private static Car_Booking__c buildCarBooking(Id wizardId, Map<String, Object> model) {
        Map<String, Object> driver = getPage(model, PAGE_DRIVER);
        Map<String, Object> car = getPage(model, PAGE_CAR);
        Map<String, Object> extras = getPage(model, PAGE_EXTRAS);
        Map<String, Object> invoice = getPage(model, PAGE_INVOICE);

        Car_Booking__c record = new Car_Booking__c();
        record.Wizard__c = wizardId;

        // Driver
        record.Full_Name__c = getString(driver, 'fullName');
        record.Email__c = getString(driver, 'email');
        record.Licence_Number__c = getString(driver, 'licenceNumber');
        record.Licence_Date__c = getDate(driver, 'licenceDate');
        record.Age__c = getDecimal(driver, 'age');
        record.I_Drive_More_Than_5_Years__c = getBoolean(driver, 'experienced');

        // Car
        record.Pickup_City__c = getString(car, 'pickupCity');
        record.Car_Class__c = getString(car, 'carClass');
        record.Pickup_Date__c = getDate(car, 'pickupDate');
        record.Rental_Days__c = getDecimal(car, 'days');
        // Shown only if (carClass='luxury'): an answer of a hidden field is not saved.
        if (getString(car, 'carClass') == 'luxury') {
            record.Full_Insurance__c = getBoolean(car, 'fullInsurance');
            record.Luxury_Notes__c = getString(car, 'luxuryNotes');
        }
        record.Booked_Through__c = getId(car, 'bookedThrough');
        record.Car_Model__c = getId(car, 'carModel');

        // Extras and Notes
        // Plan: if (CarRentalCar.days > 7). Answers of a skipped page are not saved.
        if (getDecimal(car, 'days') > 7) {
            record.Gps__c = getBoolean(extras, 'gps');
            record.Child_Seats__c = getDecimal(extras, 'childSeats');
            record.Notes__c = getString(extras, 'notes');
        }

        // Invoice
        // Plan: if (CarRentalCar.carClass='luxury'). Answers of a skipped page are not saved.
        if (getString(car, 'carClass') == 'luxury') {
            record.Vat_Number__c = getString(invoice, 'vatNumber');
            record.Billing_Contact__c = getId(invoice, 'billingContact');
            record.Big_Company__c = getId(invoice, 'bigCompany');
            record.Open_Deal__c = getId(invoice, 'openDeal');
        }

        // WIZARD-MAKER: your own rules go here. Examples:
        //
        // Stop the submit with a message for the user:
        // if (record.Amount__c == null || record.Amount__c <= 0) {
        //     throw new CarRentalException('The amount must be a positive number.');
        // }
        //
        // A value that is not asked in the wizard:
        // record.Status__c = 'pending';
        //
        // Save an answer only in some cases:
        // if (record.Quantity__c > 1) {
        //     record.Justification__c = getString(somePage, 'justification');
        // }
        return record;
    }

    /**
     * Creates the Car_Booking__c for a finished wizard, and locks the wizard: from then on
     * it can only be looked at, and a second click on Submit creates nothing. A wizard that did
     * not go through every page (or whose answers do not pass the rules of a page) is refused.
     * @return the Id of the new record
     */
    public static Id submit(Id wizardId, Boolean confirmed) {
        if (confirmed != true) {
            throw new CarRentalException('Please confirm before submitting.');
        }
        prolet__Wizard__c wizard = loadWizard(wizardId);
        if (prolet.WizardStates.isLocked(wizard.prolet__State__c)) {
            throw new CarRentalException('This wizard was submitted already.');
        }
        // the path reached the summary, and every page before it passes its rules
        prolet.WizardApi.assertCompleted(wizardId);
        Map<String, Object> model = parseModel(wizard.prolet__Model__c);
        Car_Booking__c record = buildCarBooking(wizard.Id, model);

        insert record;
        // the wizard framework: from now on the wizard can only be looked at
        prolet.WizardApi.lock(wizardId);
        return record.Id;
    }
}
