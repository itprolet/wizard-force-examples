/**
 * Tests of CarRentalService and CarRentalController.
 * WIZARD-MAKER: generated by "npm run make submit". Add a test for every rule you write in the service.
 */
@isTest
private class CarRentalServiceTest {

    /** The type of the wizard, and its steps to the summary (the steps of the plan that are always shown). */
    private static final String WIZARD_TYPE = 'CarRental';
    private static final List<prolet.WizardPageData> PATH = new List<prolet.WizardPageData>{
        new prolet.WizardPageData('CarRental_pag_driver', 'CarRentalDriver'),
        new prolet.WizardPageData('CarRental_pag_car', 'CarRentalCar'),
        new prolet.WizardPageData('CarRental_pag_summary', 'CarRentalSummary')
    };

    /**
     * A finished wizard, as WizardApi.assertCompleted accepts it: its path reached the summary, and
     * every field of those pages has an answer (a mapped one fits its field of Car_Booking__c).
     */
    private static prolet__Wizard__c createWizard() {
        return insertWizard(JSON.serialize(baseModel()), PATH);
    }

    /** The answers of createWizard: an economy car for one day (Extras and Invoice are skipped) */
    private static Map<String, Object> baseModel() {
        return new Map<String, Object>{
            'CarRentalDriver' => new Map<String, Object>{
                'fullName' => 'Test',
                'email' => 'test@example.com',
                'licenceNumber' => 'Test',
                'licenceDate' => '2026-01-15',
                'age' => '1',
                'experienced' => true
            },
            'CarRentalCar' => new Map<String, Object>{
                'pickupCity' => 'sofia',
                'carClass' => 'economy',
                'pickupDate' => '2026-01-15',
                'days' => '1',
                'fullInsurance' => true,
                'luxuryNotes' => 'Test',
                'bookedThrough' => lookupRecord('Account'),
                'carModel' => lookupRecord('Product2')
            },
            'CarRentalExtras' => new Map<String, Object>{
                'gps' => true,
                'childSeats' => '1',
                'notes' => 'Test'
            },
            'CarRentalInvoice' => new Map<String, Object>{
                'vatNumber' => 'Test',
                'billingContact' => lookupRecord('Contact'),
                'bigCompany' => lookupRecord('Account'),
                'openDeal' => lookupRecord('Opportunity')
            }
        };
    }

    /** The path when every page is shown: more than 7 days (Extras) and a luxury car (Invoice) */
    private static final List<prolet.WizardPageData> FULL_PATH = new List<prolet.WizardPageData>{
        new prolet.WizardPageData('CarRental_pag_driver', 'CarRentalDriver'),
        new prolet.WizardPageData('CarRental_pag_car', 'CarRentalCar'),
        new prolet.WizardPageData('CarRental_pag_extras', 'CarRentalExtras'),
        new prolet.WizardPageData('CarRental_pag_invoice', 'CarRentalInvoice'),
        new prolet.WizardPageData('CarRental_pag_summary', 'CarRentalSummary')
    };

    /** The answers of createWizard with another car class and number of days */
    private static Map<String, Object> modelWith(String carClass, Integer days) {
        Map<String, Object> model = baseModel();
        Map<String, Object> car = (Map<String, Object>) model.get('CarRentalCar');
        car.put('carClass', carClass);
        car.put('days', String.valueOf(days));
        return model;
    }

    /**
     * The path as the framework stores it, written from maps: Apex outside the framework's package
     * cannot serialize the package's classes (WizardPageData), so JSON.serialize(path) fails there.
     */
    private static String pathJson(List<prolet.WizardPageData> path) {
        List<Map<String, Object>> pages = new List<Map<String, Object>>();
        for (prolet.WizardPageData page : path) {
            pages.add(new Map<String, Object>{ 'title' => page.title, 'page' => page.page, 'initParams' => page.initParams,
                'paramsJson' => page.paramsJson });
        }
        return JSON.serialize(pages);
    }

    /** A wizard of this type with these answers, on this path */
    private static prolet__Wizard__c insertWizard(String modelJson, List<prolet.WizardPageData> path) {
        // ACTIVE written, not left to the picklist default: a wizard without a state is locked
        prolet__Wizard__c wizard = new prolet__Wizard__c(
            prolet__Wizard_Type__c = WIZARD_TYPE,
            prolet__State__c = prolet.WizardStates.ACTIVE,
            prolet__Model__c = modelJson,
            prolet__Path__c = pathJson(path)
        );
        insert wizard;
        return wizard;
    }

    /** One record per object for the lookups of the wizard: the fields a new record needs get a test value. */
    private static Map<String, Id> lookupRecords = new Map<String, Id>();

    private static Id lookupRecord(String objectName) {
        // a user cannot be made like other records (profile, user name, …): the running one
        if (objectName == 'User') {
            return UserInfo.getUserId();
        }
        if (!lookupRecords.containsKey(objectName)) {
            SObject record = Schema.getGlobalDescribe().get(objectName).newSObject();
            for (Schema.SObjectField field : record.getSObjectType().getDescribe().fields.getMap().values()) {
                Schema.DescribeFieldResult describe = field.getDescribe();
                if (describe.isCreateable() && !describe.isNillable() && !describe.isDefaultedOnCreate()) {
                    record.put(field, testValue(describe));
                }
            }
            insert record;
            lookupRecords.put(objectName, record.Id);
        }
        return lookupRecords.get(objectName);
    }

    private static Object testValue(Schema.DescribeFieldResult describe) {
        switch on describe.getType() {
            when DOUBLE, CURRENCY, PERCENT, INTEGER, LONG {
                return 1;
            }
            when DATE {
                return Date.today();
            }
            when DATETIME {
                return Datetime.now();
            }
            when EMAIL {
                return 'test@example.com';
            }
            when BOOLEAN {
                return false;
            }
            when PICKLIST {
                return describe.getPicklistValues()[0].getValue();
            }
            when else {
                return 'Test';
            }
        }
    }

    @isTest
    static void submitCreatesTheRecord() {
        prolet__Wizard__c wizard = createWizard();

        Test.startTest();
        Id recordId = CarRentalController.submit(wizard.Id, true);
        Test.stopTest();

        Car_Booking__c record = [
            SELECT Id, Wizard__c, Full_Name__c, Email__c, Licence_Number__c, Licence_Date__c, Age__c, I_Drive_More_Than_5_Years__c, Pickup_City__c, Car_Class__c, Pickup_Date__c, Rental_Days__c, Full_Insurance__c, Luxury_Notes__c, Booked_Through__c, Car_Model__c, Gps__c, Child_Seats__c, Notes__c, Vat_Number__c, Billing_Contact__c, Big_Company__c, Open_Deal__c
            FROM Car_Booking__c
            WHERE Id = :recordId
        ];
        Assert.areEqual(wizard.Id, record.Wizard__c, 'The record is linked to its wizard');
        // every answer is in its field (empty when its page or the field is hidden for these answers)
        Assert.areEqual('Test', record.Full_Name__c, 'Full_Name__c');
        Assert.areEqual('test@example.com', record.Email__c, 'Email__c');
        Assert.areEqual('Test', record.Licence_Number__c, 'Licence_Number__c');
        Assert.areEqual(Date.valueOf('2026-01-15'), record.Licence_Date__c, 'Licence_Date__c');
        Assert.areEqual(Decimal.valueOf('1'), record.Age__c, 'Age__c');
        Assert.areEqual(true, record.I_Drive_More_Than_5_Years__c, 'I_Drive_More_Than_5_Years__c');
        Assert.areEqual('sofia', record.Pickup_City__c, 'Pickup_City__c');
        Assert.areEqual('economy', record.Car_Class__c, 'Car_Class__c');
        Assert.areEqual(Date.valueOf('2026-01-15'), record.Pickup_Date__c, 'Pickup_Date__c');
        Assert.areEqual(Decimal.valueOf('1'), record.Rental_Days__c, 'Rental_Days__c');
        Assert.areEqual(false, record.Full_Insurance__c, 'Full_Insurance__c');
        Assert.isNull(record.Luxury_Notes__c, 'Luxury_Notes__c stays empty');
        Assert.areEqual(lookupRecord('Account'), record.Booked_Through__c, 'Booked_Through__c');
        Assert.areEqual(lookupRecord('Product2'), record.Car_Model__c, 'Car_Model__c');
        Assert.areEqual(false, record.Gps__c, 'Gps__c');
        Assert.isNull(record.Child_Seats__c, 'Child_Seats__c stays empty');
        Assert.isNull(record.Notes__c, 'Notes__c stays empty');
        Assert.isNull(record.Vat_Number__c, 'Vat_Number__c stays empty');
        Assert.isNull(record.Billing_Contact__c, 'Billing_Contact__c stays empty');
        Assert.isNull(record.Big_Company__c, 'Big_Company__c stays empty');
        Assert.isNull(record.Open_Deal__c, 'Open_Deal__c stays empty');
    }

    @isTest
    static void everyPageShownSavesEveryAnswer() {
        // a luxury car for 10 days: the luxury fields, Extras and Invoice are shown
        prolet__Wizard__c wizard = insertWizard(JSON.serialize(modelWith('luxury', 10)), FULL_PATH);

        Test.startTest();
        Id recordId = CarRentalController.submit(wizard.Id, true);
        Test.stopTest();

        Car_Booking__c record = [
            SELECT Car_Class__c, Rental_Days__c, Full_Insurance__c, Luxury_Notes__c, Gps__c, Child_Seats__c, Notes__c,
                Vat_Number__c, Billing_Contact__c, Big_Company__c, Open_Deal__c
            FROM Car_Booking__c
            WHERE Id = :recordId
        ];
        Assert.areEqual('luxury', record.Car_Class__c, 'Car_Class__c');
        Assert.areEqual(10, record.Rental_Days__c, 'Rental_Days__c');
        // shown only for a luxury car
        Assert.areEqual(true, record.Full_Insurance__c, 'Full_Insurance__c');
        Assert.areEqual('Test', record.Luxury_Notes__c, 'Luxury_Notes__c');
        // Extras: only for more than 7 days
        Assert.areEqual(true, record.Gps__c, 'Gps__c');
        Assert.areEqual(1, record.Child_Seats__c, 'Child_Seats__c');
        Assert.areEqual('Test', record.Notes__c, 'Notes__c');
        // Invoice: only for a luxury car
        Assert.areEqual('Test', record.Vat_Number__c, 'Vat_Number__c');
        Assert.areEqual(lookupRecord('Contact'), record.Billing_Contact__c, 'Billing_Contact__c');
        Assert.areEqual(lookupRecord('Account'), record.Big_Company__c, 'Big_Company__c');
        Assert.areEqual(lookupRecord('Opportunity'), record.Open_Deal__c, 'Open_Deal__c');
    }

    @isTest
    static void sevenDaysAreNotEnoughForTheExtras() {
        // "days > 7": 7 days skip Extras, so its answers are not saved although the model has them
        List<prolet.WizardPageData> path = new List<prolet.WizardPageData>{ PATH[0], PATH[1], FULL_PATH[3], PATH[2] };
        prolet__Wizard__c wizard = insertWizard(JSON.serialize(modelWith('luxury', 7)), path);

        Id recordId = CarRentalController.submit(wizard.Id, true);

        Car_Booking__c record = [
            SELECT Gps__c, Child_Seats__c, Notes__c, Vat_Number__c FROM Car_Booking__c WHERE Id = :recordId
        ];
        Assert.areEqual(false, record.Gps__c, 'Gps__c is not saved');
        Assert.isNull(record.Child_Seats__c, 'Child_Seats__c is not saved');
        Assert.isNull(record.Notes__c, 'Notes__c is not saved');
        // the Invoice page is still shown (a luxury car)
        Assert.areEqual('Test', record.Vat_Number__c, 'Vat_Number__c');
    }

    @isTest
    static void aSecondSubmitIsRefused() {
        prolet__Wizard__c wizard = createWizard();
        CarRentalController.submit(wizard.Id, true);
        Assert.areEqual('LOCKED', [SELECT prolet__State__c FROM prolet__Wizard__c WHERE Id = :wizard.Id].prolet__State__c,
                'The wizard can only be looked at');
        try {
            CarRentalController.submit(wizard.Id, true);
            Assert.fail('A second submit should fail');
        } catch (AuraHandledException e) {
            Assert.areEqual('This wizard was submitted already.', e.getMessage());
            Assert.areEqual(1, [SELECT COUNT() FROM Car_Booking__c], 'Nothing more was created');
        }
    }

    @isTest
    static void submitNeedsTheConfirmation() {
        prolet__Wizard__c wizard = createWizard();
        try {
            CarRentalController.submit(wizard.Id, false);
            Assert.fail('The submit should fail without the confirmation');
        } catch (AuraHandledException e) {
            // the service's own message, as it is (the controller's first catch)
            Assert.isFalse(e.getMessage().startsWith('Could not submit: '), e.getMessage());
            Assert.areEqual(0, [SELECT COUNT() FROM Car_Booking__c], 'Nothing was created');
        }
    }

    @isTest
    static void aWizardThatDidNotReachTheSummaryIsRefused() {
        prolet__Wizard__c wizard = insertWizard(JSON.serialize(new Map<String, Object>()), new List<prolet.WizardPageData>{ PATH[0] });
        try {
            CarRentalController.submit(wizard.Id, true);
            Assert.fail('The submit should fail before the last page');
        } catch (AuraHandledException e) {
            // the wizard's own message, as it is (the controller's catch of WizardException)
            Assert.isTrue(e.getMessage().startsWith(System.Label.get('prolet', 'Wizard_err_not_completed')), e.getMessage());
            Assert.areEqual(0, [SELECT COUNT() FROM Car_Booking__c], 'Nothing was created');
        }
    }

    @isTest
    static void anUnexpectedProblemReachesTheUserAsAMessage() {
        // data that cannot be read: not one of the service's own messages, so the controller's
        // last catch turns it into a message for the user (and this test covers that catch)
        prolet__Wizard__c wizard = insertWizard('not JSON', PATH);
        try {
            CarRentalController.submit(wizard.Id, true);
            Assert.fail('The submit should fail when the data cannot be read');
        } catch (AuraHandledException e) {
            // only the controller's last catch says this: if the service turns bad data into a
            // message of its own, this test fails instead of leaving that catch uncovered
            Assert.isTrue(e.getMessage().startsWith('Could not submit: '), e.getMessage());
            Assert.areEqual(0, [SELECT COUNT() FROM Car_Booking__c], 'Nothing was created');
        }
    }

    @isTest
    static void submitFailsWithoutData() {
        // on the summary, but without answers: no page has any to check, the service finds none
        prolet__Wizard__c wizard = insertWizard(null, PATH);
        try {
            CarRentalService.submit(wizard.Id, true);
            Assert.fail('The submit should fail when the wizard has no data');
        } catch (CarRentalException e) {
            Assert.areEqual('The wizard has no data.', e.getMessage(), 'The user sees why');
        }
    }
}
